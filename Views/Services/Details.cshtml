@model Hairstories.Models.Service
@{
    ViewData["Title"] = "Service Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <h2><i class="fas fa-spa"></i> @Model.ServiceName</h2>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Service Information</h5>
            </div>
            <div class="card-body">
                <p><strong>Name:</strong> @Model.ServiceName</p>
                <p><strong>Description:</strong> @(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)</p>
                <p><strong>Duration:</strong> @Model.DurationMinutes minutes</p>
                <p><strong>Price:</strong> <strong class="text-success">@Model.Price.ToString("C")</strong></p>
                <p><strong>Status:</strong>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </p>
            </div>
        </div>
    </div>
</div>

<div class="d-grid gap-2 d-md-flex justify-content-md-start mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
        <i class="fas fa-edit"></i> Edit
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>
