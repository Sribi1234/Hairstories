@model Hairstories.Models.Service
@{
    ViewData["Title"] = "Add Service";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <h2><i class="fas fa-plus-circle"></i> Add Service</h2>
</div>

<div class="form-section">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label asp-for="ServiceName" class="form-label">Service Name</label>
                <input asp-for="ServiceName" class="form-control" placeholder="E.g., Hair Cut, Hair Styling" />
                <span asp-validation-for="ServiceName" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the service..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="DurationMinutes" class="form-label">Duration (Minutes)</label>
                <input asp-for="DurationMinutes" class="form-control" type="number" min="5" placeholder="E.g., 30" />
                <span asp-validation-for="DurationMinutes" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Price" class="form-label">Price</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="E.g., 35.00" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" checked />
                <label asp-for="IsActive" class="form-check-label">
                    Is Active
                </label>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Create Service</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
