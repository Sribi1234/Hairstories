@model IEnumerable<Hairstories.Models.Staff>
@{
    ViewData["Title"] = "Staff Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-tie"></i> Staff Management</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Staff
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No staff members found. 
        <a asp-action="Create">Add the first staff member.</a>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Working Hours</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model)
                    {
                        <tr>
                            <td><strong>@staff.FullName</strong></td>
                            <td>@staff.Email</td>
                            <td>@staff.Phone</td>
                            <td>
                                <span class="badge bg-secondary">@staff.Role</span>
                            </td>
                            <td>@staff.WorkingHours</td>
                            <td>
                                @if (staff.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@staff.Id" class="btn btn-outline-primary" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@staff.Id" class="btn btn-outline-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @if (staff.Role == Hairstories.Models.StaffRole.Stylist)
                                    {
                                        <a asp-action="AssignServices" asp-route-id="@staff.Id" class="btn btn-outline-info" title="Assign Services">
                                            <i class="fas fa-link"></i>
                                        </a>
                                    }
                                    <form asp-action="Delete" asp-route-id="@staff.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-outline-danger" title="Delete" onclick="return confirm('Are you sure?');">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
