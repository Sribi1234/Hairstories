@model Hairstories.Models.Customer
@{
    ViewData["Title"] = "Customer Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <h2><i class="fas fa-user-circle"></i> @Model.FullName</h2>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Customer Information</h5>
            </div>
            <div class="card-body">
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>Phone:</strong> @Model.Phone</p>
                <p><strong>Notes:</strong> @(string.IsNullOrEmpty(Model.Notes) ? "-" : Model.Notes)</p>
                <p><strong>Status:</strong>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </p>
                <p><strong>Registered:</strong> @Model.CreatedDate.ToString("dddd, MMMM dd, yyyy")</p>
            </div>
        </div>
    </div>

    @if (Model.Appointments?.Any() == true)
    {
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Appointment History</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Service</th>
                                <th>Stylist</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.Appointments.OrderByDescending(a => a.AppointmentDateTime).Take(5))
                            {
                                <tr>
                                    <td>@appt.AppointmentDateTime.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@appt.Service?.ServiceName</td>
                                    <td>@appt.Staff?.FullName</td>
                                    <td><span class="badge bg-info">@appt.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<div class="d-grid gap-2 d-md-flex justify-content-md-start">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
        <i class="fas fa-edit"></i> Edit
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>
