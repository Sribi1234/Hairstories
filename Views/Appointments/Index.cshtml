@model IEnumerable<Hairstories.Models.Appointment>
@{
    ViewData["Title"] = "Appointments";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var selectedDate = ViewBag.SelectedDate as DateTime? ?? DateTime.Now;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar"></i> Appointments</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Book Appointment
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-md-4">
                <label for="dateInput" class="form-label">Select Date:</label>
                <input type="date" id="dateInput" name="date" class="form-control" value="@selectedDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-info w-100">Filter</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-secondary w-100">Today</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Appointments for @selectedDate.ToString("dddd, MMMM dd, yyyy")</h5>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Time</th>
                        <th>Customer</th>
                        <th>Service</th>
                        <th>Duration</th>
                        <th>Stylist</th>
                        <th>Price</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.OrderBy(a => a.AppointmentDateTime))
                    {
                        <tr>
                            <td>@appt.AppointmentDateTime.ToString("hh:mm tt")</td>
                            <td>@appt.Customer?.FullName</td>
                            <td>@appt.Service?.ServiceName</td>
                            <td>@appt.Service?.DurationMinutes min</td>
                            <td>@appt.Staff?.FullName</td>
                            <td>@appt.ServicePrice.ToString("C")</td>
                            <td>
                                @if (appt.PaymentStatus == Hairstories.Models.PaymentStatus.Paid)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else if (appt.PaymentStatus == Hairstories.Models.PaymentStatus.Pending)
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Refunded</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-info">@appt.Status</span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@appt.Id" class="btn btn-outline-primary" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (appt.Status != Hairstories.Models.AppointmentStatus.Cancelled && appt.Status != Hairstories.Models.AppointmentStatus.Completed)
                                    {
                                        <a asp-action="Edit" asp-route-id="@appt.Id" class="btn btn-outline-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    }
                                    @if (appt.Status != Hairstories.Models.AppointmentStatus.Cancelled)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@appt.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Cancel" onclick="return confirm('Cancel this appointment?');">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body">
            <p class="text-muted text-center mb-0">
                <i class="fas fa-calendar-alt"></i> No appointments scheduled for this date.
            </p>
        </div>
    }
</div>
