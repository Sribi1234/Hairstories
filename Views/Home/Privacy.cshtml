@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-8">
        <h2>Privacy Policy</h2>
        <p>
            This Salon Management System collects and processes personal information to manage salon operations, 
            including staff management, customer profiles, and appointment scheduling.
        </p>
        <h4>Information We Collect:</h4>
        <ul>
            <li>Staff: Name, Email, Phone, Role, Working Hours</li>
            <li>Customers: Name, Email, Phone, Service History</li>
            <li>Appointments: Date, Time, Service, Staff, Payment Information</li>
        </ul>
        <h4>Data Usage:</h4>
        <p>We use this information solely for salon management purposes and do not share it with third parties.</p>
    </div>
</div>
