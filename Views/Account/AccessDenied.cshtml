@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card text-center">
            <div class="card-body p-5">
                <h1 class="display-1"><i class="fas fa-lock"></i></h1>
                <h2 class="card-title">Access Denied</h2>
                <p class="card-text">You do not have permission to access this resource.</p>
                <a asp-action="Index" asp-controller="Home" class="btn btn-primary">
                    <i class="fas fa-home"></i> Back to Home
                </a>
            </div>
        </div>
    </div>
</div>
